<%- include('../partials/header.ejs')%> 
<main>
    <form class="user-form-css" action="/users" method="POST">
        <div class="row">
            <div class="col-25">
                <label for="firstName">First Name</label>
            </div>
            <div class="col-75">
                <input id="firstName" name="firstName" type="firstName" placeholder="First Name" required>
            </div>
        </div>
        <div class="row">
            <div class="col-25">
                <label for="lastName">Last Name</label>
            </div>
            <div class="col-75">
                <input id="lastName" name="lastName" type="lastName" placeholder="Last Name" required>
            </div>
        </div>
        <div class="row">
            <div class="col-25">
                <label for="email">Email Address</label>
            </div>
            <div class="col-75">
                <input id="email" name="email" type="email" placeholder="Email" required>
            </div>
        </div>
        <div class="row">
            <div class="col-25">
                <label for="password">Password</label>
            </div>
            <div class="col-75">
                <input id="password" name="password" type="password" placeholder="Password" required>
            </div>
        </div>
        <br>
        <button><strong>Sign Up</strong></button>  
    </form>
</main>
<%- include('../partials/footer.ejs')%> 